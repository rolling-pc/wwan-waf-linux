#!/bin/bash

parentdir=$(cd `dirname $0`/../../..; pwd)
BUILD_DIR=${parentdir}/build
LIB_PATH=${BUILD_DIR}/release_lib/*
TOOL_LIB_PATH=${BUILD_DIR}/release_lib/private_tool_kits
WWAN_FUNC_PATH=${BUILD_DIR}/src/wsf/wwan_func_service
WWAN_DEV_PATH=${BUILD_DIR}/src/wsf/wwan_dev_service
WWAN_MA_PATH=${BUILD_DIR}/src/wsf/wwan_plugin/ma_service
WWAN_TOOL_KITS_PATH=${BUILD_DIR}/src/wtf/tool_kits_service

WWAN_BAND_INFO_PATH=${BUILD_DIR}/../src/wtf/tool_kits_service/private_tool_kits/config_file/BandInfo.xml

UI_PATH=${BUILD_DIR}/UI
WWAN_CLI_PATH=${BUILD_DIR}/src/cli

RELEASE_DEB_RPM_PATH=${BUILD_DIR}/release/opt/waf
RELEASE_RUN_PATH=${BUILD_DIR}/release/usr/local/opt/waf


echo "***************$3*******************"
# script run path

SOURCE_RUN_SCRIPT_PATH=${parentdir}/script/linux/cpack_source/run

RELEASE_PATH=''
RELEASE_SERVICE_FUNC_PATH=''
RELEASE_SERVICE_DEV_PATH=''
RELEASE_PLUGIN_MA_PATH=''
RELEASE_LIB_PATH=''
RELEASE_TOOL_KITS_PATH=''
RELEASE_UI_PATH=''
RELEASE_CLI_PATH=''
RELEASE_SCRIPT_PATH=''

RELSEASE_DESKTOP_PATH=${BUILD_DIR}/release/usr/share/applications/
SOURCE_ICON_PATH=${parentdir}/script/linux/cpack_source/rolling.png
# SOURCE_ICON_PATH=${parentdir}/script/linux/cpack_source/tool_kits.ico

RELEASE_SYSTEMD_PATH=${BUILD_DIR}/release/lib/systemd/system/
RELEASE_SYSTEMD_FUNC_CONF_PATH=${RELEASE_SYSTEMD_PATH}/wwan_func.d
RELEASE_SYSTEMD_DEV_CONF_PATH=${RELEASE_SYSTEMD_PATH}/wwan_dev.d
RELEASE_SYSTEMD_MA_CONF_PATH=${RELEASE_SYSTEMD_PATH}/wwan_ma.d

RELEASE_INIT_PATH=${RELEASE_RUN_PATH}/etc/init

# tool_kits

function create_fibcli_intstall()
{
    mkdir -p ${RELEASE_CLI_PATH}
    cp -raf ${WWAN_CLI_PATH}/cli ${RELEASE_CLI_PATH}
}

function create_lib_intstall()
{
    mkdir -p ${RELEASE_LIB_PATH}
    cp -raf ${LIB_PATH} ${RELEASE_LIB_PATH}

    # 添加ICU 70库支持
    if [ -d "${BUILD_DIR}/release_lib/icu_lib" ]; then
        mkdir -p ${RELEASE_LIB_PATH}/icu_lib
        cp -raf ${BUILD_DIR}/release_lib/icu_lib/* ${RELEASE_LIB_PATH}/icu_lib/
        echo "ICU 70 libraries copied to package"
    fi

    find "$RELEASE_LIB_PATH" -type d -name "api" -exec rm -rf {} +
}

function create_tool_start()
{
    echo "env LD_LIBRARY_PATH=/usr/local/opt/waf/libs/cxx_lib:/usr/local/opt/waf/libs/qc_lib:\$LD_LIBRARY_PATH exec /usr/local/opt/waf/tools/tool_kits_service/tool_kits" > $1/tool_kits.sh
}

function create_wwan_tool_service_conf()
{
    echo "# Copyright 2024 The ROLLING Authors
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

description     \"starts wwan_tool service has been started.\"
author          \"Rolling Wireless S.a.r.l.\"

oom score -100


start on starting system-services
stop on stopping system-services

respawn
# if the job respawns 3 times in 30 seconds, stop trying.
respawn limit 3 30
# Do not respawn if we exited on purpose (e.g. service disabled).
normal exit 0

# Keep track of the wwan_dev process launched by minijail instead of the
# minijail process. minijail exits immediately after launching wwan_dev.

script
  # Override logging level if sticky flag exists.
  mkdir -p /var/log/waf/out || True
  LD_LIBRARY_PATH=/usr/local/opt/waf/libs/cxx_lib:/usr/local/opt/waf/libs/qc_lib:\$LD_LIBRARY_PATH \\
  exec /usr/local/opt/waf/tools/tool_kits_service/tool_kits
end script" > $1/wwan_tool.conf

}



function create_tools_intstall()
{
    mkdir -p ${RELEASE_TOOL_KITS_PATH}
    cp -raf ${WWAN_TOOL_KITS_PATH}/tool_kits ${RELEASE_TOOL_KITS_PATH}
    # create_tool_start ${RELEASE_RUN_PATH}/script
    if [[ $1 == "run" ]]; then
        mkdir -p ${RELEASE_INIT_PATH}
        create_wwan_tool_service_conf ${RELEASE_INIT_PATH}
    fi
    # create_tool_start ${RELEASE_RUN_PATH}/script
    if [[ $1 == "run" ]]; then
        mkdir -p ${RELEASE_INIT_PATH}
        create_wwan_tool_service_conf ${RELEASE_INIT_PATH}
    fi
    mkdir -p ${RELEASE_UI_PATH}
    cp -raf ${UI_PATH}/* ${RELEASE_UI_PATH}
    mkdir -p ${RELEASE_LIB_PATH}
    cp -raf ${TOOL_LIB_PATH} ${RELEASE_LIB_PATH}

    find "$RELEASE_LIB_PATH" -type d -name "api" -exec rm -rf {} +
    if [[ $1 == "run" ]]; then
        echo "run pacage no need desktop icon"
    else
        mkdir -p ${RELSEASE_DESKTOP_PATH}
        create_tools_desktop ${RELSEASE_DESKTOP_PATH} $1
        cp -raf ${SOURCE_ICON_PATH}  ${RELEASE_TOOL_KITS_PATH}
    fi

    cp -raf ${WWAN_BAND_INFO_PATH}  ${RELEASE_TOOL_KITS_PATH}
}

function create_wwan_func_d()
{
    echo "LD_LIBRARY_PATH=/opt/waf/libs/cxx_lib/:\$LD_LIBRARY_PATH:/usr/local/lib" > $1/env.conf

}

function create_wwan_dev_d()
{
    echo "LD_LIBRARY_PATH=/opt/waf/libs/cxx_lib/:\$LD_LIBRARY_PATH:/usr/local/lib" > $1/env.conf
}

function create_wwan_ma_d()
{
    echo "LD_LIBRARY_PATH=/opt/waf/libs/cxx_lib/:\$LD_LIBRARY_PATH:/usr/local/lib" > $1/env.conf
}

function create_wwan_func_service()
{
    echo "[Unit]
Description=function flash and config modem Service
After=wwan_dev.service

[Service]
EnvironmentFile=/lib/systemd/system/wwan_func.d/env.conf
ExecStart=/opt/waf/wwan_service/wwan_func/wwan_func_service
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root
TimeoutSec=3

[Install]
Alias=wwan_func.service
WantedBy=multi-user.target" > $1/wwan_func.service

}

function create_wwan_dev_service()
{
    echo "[Unit]
Description=function device manager Service
After=ModemManager.service

[Service]
EnvironmentFile=/lib/systemd/system/wwan_dev.d/env.conf
ExecStart=/opt/waf/wwan_service/wwan_dev/wwan_dev_service
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

[Install]
Alias=wwan_dev.service
WantedBy=multi-user.target" > $1/wwan_dev.service
}

function create_wwan_ma_service()
{
    echo "[Unit]
Description=WWAN MA Service
After=ModemManager.service

[Service]
EnvironmentFile=/lib/systemd/system/wwan_ma.d/env.conf
ExecStart=/opt/waf/wwan_service/wwan_plugin/wwan_ma
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

[Install]
Alias=wwan_ma.service
WantedBy=multi-user.target" > $1/wwan_ma.service
}


function create_wwan_dev_service_conf()
{
    echo "# Copyright 2024 The ROLLING Authors
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

description     \"starts wwan_dev service has been started.\"
author          \"Rolling Wireless S.a.r.l.\"

oom score -100


start on starting system-services
stop on stopping system-services

respawn
# if the job respawns 3 times in 30 seconds, stop trying.
respawn limit 3 30
# Do not respawn if we exited on purpose (e.g. service disabled).
normal exit 0

# Keep track of the wwan_dev process launched by minijail instead of the
# minijail process. minijail exits immediately after launching wwan_dev.

script
  mkdir -p /var/log/waf/out || True
  # Override logging level if sticky flag exists.
  LD_LIBRARY_PATH=/usr/local/opt/waf/libs/cxx_lib:/usr/local/opt/waf/libs/qc_lib:\$LD_LIBRARY_PATH \\
  exec /usr/local/opt/waf/wwan_service/wwan_dev/wwan_dev_service 2>> /var/log/waf/out/wwan_dev.log
end script" > $1/wwan_dev.conf

}

