#!/bin/bash
set -e
# see: dh_installdeb(1)
#      https://www.debian.org/doc/manuals/maint-guide/dother.en.html#maintscripts
# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    purge|remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    systemctl daemon-reload

    if [ -d "/usr/lib/x86_64-linux-gnu/ModemManager/fcc-unlock.d" ]; then
        if [ -d "/opt/waf/wwan_service/wwan_plugin" ]; then
            rm -rf /usr/lib/x86_64-linux-gnu/ModemManager/fcc-unlock.d
        fi
    elif [ -d "/usr/lib64/ModemManager/fcc-unlock.d" ]; then
        if [ -d "/opt/waf/wwan_service/wwan_plugin" ]; then
            rm -rf /usr/lib64/ModemManager/fcc-unlock.d
        fi
    fi

    if [ -d "/etc/opt/waf/run/wwan_func" ]; then
        rm -rf /etc/opt/waf/run/wwan_func
        if [ -z "$(ls -A "/etc/opt/waf/run")" ]; then
            rm -rf /etc/opt/waf/run
        fi

        if [ -z "$(ls -A "/etc/opt/waf/waf_fw_pkg/")" ]; then
            rm -rf /etc/opt/waf/waf_fw_pkg/
        fi

        if [ -z "$(ls -A "/etc/opt/waf")" ]; then
            rm -rf /etc/opt/waf
        fi
    fi

    # Added by Mirshat, 2025-02-13, JIRA: PC0192-145, for removing the rolling directory
    if [ -d "/etc/opt/rolling" ]; then
        rm -rf /etc/opt/rolling
    fi
    # End added by Mirshat, 2025-02-13, JIRA: PC0192-145
    ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
