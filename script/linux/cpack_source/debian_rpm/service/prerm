#!/bin/bash
set -e
# see: dh_installdeb(1)
#      https://www.debian.org/doc/manuals/maint-guide/dother.en.html#maintscripts
# summary of how this script can be called:
#        * <prerm> `remove'
#        * <old-prerm> `upgrade' <new-version>
#        * <new-prerm> `failed-upgrade' <old-version>
#        * <conflictor's-prerm> `remove' `in-favour' <package> <new-version>
#        * <deconfigured's-prerm> `deconfigure' `in-favour'
#          <package-being-installed> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    remove|upgrade|deconfigure)
    path="/lib/systemd/system/"
    #stop service
    if [[ -f ${path}wwan_dev.service && -f ${path}wwan_func.service ]];then
        systemctl stop wwan_dev.service wwan_func.service
        systemctl disable wwan_dev.service wwan_func.service
    fi

    if [ -d "/usr/lib/x86_64-linux-gnu/ModemManager/fcc-unlock.d" ]; then
        rm -rf /usr/lib/x86_64-linux-gnu/ModemManager/fcc-unlock.d
    elif [ -d "/usr/lib64/ModemManager/fcc-unlock.d" ]; then
        rm -rf /usr/lib64/ModemManager/fcc-unlock.d
    fi
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
