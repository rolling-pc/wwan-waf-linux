#!/bin/bash
set -e
# see: dh_installdeb(1)
#      https://www.debian.org/doc/manuals/maint-guide/dother.en.html#maintscripts
# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
    if [ -d "/opt/waf/wwan_service/wwan_func" ]; then
        mkdir -p /etc/opt/waf/run/wwan_func
        mkdir -p /etc/opt/waf/waf_fw_pkg/
    fi
    path="/lib/systemd/system/"
    # ===== [开源改造 START] 逐个 unit 判断：本包不含 wwan_ma.service，不能要求三个 unit 同时存在 =====
    for unit in wwan_dev.service wwan_func.service wwan_ma.service; do
        if [[ -f ${path}${unit} ]]; then
            systemctl enable ${unit} || true
            systemctl start  ${unit} || true
        fi
    done
    # ===== [开源改造 END] =====
    if [ -d "/usr/lib/x86_64-linux-gnu/ModemManager" ]; then
        if [ -d "/opt/waf/wwan_service/wwan_plugin/fcc-unlock.d" ]; then
            cp -raf  /opt/waf/wwan_service/wwan_plugin/fcc-unlock.d  /usr/lib/x86_64-linux-gnu/ModemManager/
            chown -R root:root  /usr/lib/x86_64-linux-gnu/ModemManager/fcc-unlock.d
            chmod 755 -R /usr/lib/x86_64-linux-gnu/ModemManager/fcc-unlock.d
        fi
    elif [ -d "/usr/lib64/ModemManager" ]; then
        if [ -d "/opt/waf/wwan_service/wwan_plugin/fcc-unlock.d" ]; then
            cp -raf  /opt/waf/wwan_service/wwan_plugin/fcc-unlock.d  /usr/lib64/ModemManager/
            chown -R root:root  /usr/lib64/ModemManager/fcc-unlock.d
            chmod 755 -R /usr/lib64/ModemManager/fcc-unlock.d
        fi
    else
        echo "No ModemManager directory found!"
    fi
	
	udevadm control -R
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
