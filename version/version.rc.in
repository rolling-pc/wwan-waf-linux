#include <windows.h>
 
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @WWAN_DEV_MAJOR_VERSION@,@WWAN_DEV_MINOR_VERSION@,@WWAN_DEV_PATCH_VERSION@,0
PRODUCTVERSION  @WWAN_DEV_MAJOR_VERSION@,@WWAN_DEV_MINOR_VERSION@,@WWAN_DEV_PATCH_VERSION@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",    "@PROJECT_NAME@"
            VALUE "FileVersion",        "@WWAN_DEV_VERSION_STRING@"
            VALUE "InternalName",       "@PROJECT_NAME@"
            VALUE "LegalCopyright",     "Copyright @ 2026 Rolling Wireless Inc."
            VALUE "OriginalFilename",   "@PROJECT_NAME@.exe"
            VALUE "ProductName",        "@PROJECT_NAME@"
            VALUE "ProductVersion",     "@WWAN_DEV_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END